# Copy to `.dev.vars` for local development, or run `bun run setup` to generate
# one with fresh secrets. Never commit `.dev.vars`.

# Password for the web app and the share target. Required.
APP_PASSWORD=replace-with-a-long-password

# Optional. Signs the session cookie. If omitted, APP_PASSWORD is used.
# APP_SECRET=replace-with-another-long-secret

# Optional. Which provider writes summaries: cloudflare (default, no key),
# opencode, claude, openai, or custom. Normally set it in wrangler.jsonc.
# AI_PROVIDER=cloudflare

# Key for the chosen provider. Not used by cloudflare, which uses the AI binding.
AI_API_KEY=

# Supadata key. Optional: enables YouTube captions inside the Worker.
# SUPADATA_API_KEY=

# Optional: any transcript service, tried before Supadata. Use {videoId} and/or
# {url} as placeholders. JSON {text}, WebVTT, SRT, or plain text are accepted.
# TRANSCRIPT_API_URL=https://example.com/transcript?url={url}
# TRANSCRIPT_API_KEY=
# Header for that token. Default is Authorization: Bearer. Use x-api-key for
# Brevyd/Supadata-style services.
# TRANSCRIPT_API_HEADER=

# YouTube captions work with no key: two public Piped instances are tried by
# default. Override with one instance or a comma-separated ladder, or "off" to
# skip Piped (for example when SUPADATA_API_KEY is set).
# PIPED_API_URL=https://api.piped.private.coffee,https://pipedapi.ducks.party

# Read-only GitHub token. Optional: raises the API rate limit for link reading.
# GITHUB_TOKEN=

# Optional. Add-only bearer token for scripts and automation on
# POST /api/bookmarks. The mobile apps sign in with the password instead, so
# they do not need it. Use a long random value; the same value must be set as
# the Worker secret.
SHARE_TOKEN=
