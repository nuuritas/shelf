{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Keep this script name. The product is Shelf now, but Durable Object
  // storage belongs to the Worker script, so renaming it would publish a new,
  // empty archive. Only the visible branding changed.
  "name": "x-bookmark-vault",
  "main": "src/worker.ts",
  "workers_dev": true,
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./public"
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOOKMARKS",
        "class_name": "Bookmarks"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Bookmarks"]
    }
  ],
  // Summaries run on the Workers AI binding above, which needs no API key.
  // To use another provider, add "AI_PROVIDER" here (opencode, claude, openai,
  // or custom) and set AI_API_KEY as a secret. A custom endpoint also needs:
  //   "AI_BASE_URL": "https://api.example.com/v1",
  //   "AI_MODEL": "some-model",
  // YouTube captions also work with no key: public Piped instances are tried
  // unless you set "PIPED_API_URL" (a ladder, or "off").
  "vars": {
    "SUMMARY_LANGUAGE": "en"
  }
}
