{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "x-bookmark-vault",
  "main": "src/worker.ts",
  "workers_dev": true,
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./public"
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOOKMARKS",
        "class_name": "Bookmarks"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Bookmarks"]
    }
  ],
  // Defaults for a fresh deploy. Override with `wrangler secret put` (keys) or
  // by editing the vars below (endpoint, model, summary language).
  "vars": {
    "AI_BASE_URL": "https://api.openai.com/v1",
    "AI_MODEL": "gpt-4.1-mini",
    "SUMMARY_LANGUAGE": "en"
  }
}
