{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "x-bookmark-vault",
  "main": "src/worker.ts",
  "workers_dev": true,
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./public"
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOOKMARKS",
        "class_name": "Bookmarks"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Bookmarks"]
    }
  ],
  // Summaries run on the Workers AI binding above, which needs no API key.
  // To use an external OpenAI-compatible endpoint instead, set AI_API_KEY as a
  // secret and add:
  //   "AI_BASE_URL": "https://api.openai.com/v1",
  //   "AI_MODEL": "gpt-4.1-mini",
  "vars": {
    "SUMMARY_LANGUAGE": "en"
  }
}
